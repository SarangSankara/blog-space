---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
---

<BaseLayout title="Stay Curious">
  <div class="max-w-4xl mx-auto px-4 py-16">
    <header class="border-b border-gray-100 pb-12 mb-12">
      <h1 class="text-6xl font-bold font-sans tracking-tight text-gray-900 mb-4">
        Stay curious.
      </h1>
      <p class="text-xl text-gray-600 font-sans max-w-xl">
        Discover stories, thinking, and expertise from writers on any topic.
      </p>
    </header>

    <section class="space-y-12">
      {posts.map((post) => (
        <article class="pb-8 border-b border-gray-50 group">
          <div class="text-xs text-gray-500 mb-2">
            <span class="font-medium text-gray-800">Sarang</span> · {post.data.pubDate}
          </div>
          
          <a href={`/blog/${post.id}`} class="block">
            <h2 class="text-2xl font-bold font-sans text-gray-900 group-hover:text-gray-600 transition mb-2">
              {post.data.title}
            </h2>
          </a>
          
          <p class="text-gray-500 font-serif line-clamp-2">
            {post.data.description}
          </p>
        </article>
      ))}
    </section>
  </div>
</BaseLayout>